# UpayEvents Insight — local environment
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real values.

# Supabase Postgres connection string.
# Supabase dashboard -> your project -> Connect -> "Session pooler" (works on
# IPv4 networks and supports migrations). Replace [YOUR-PASSWORD] with your
# database password. Used by the app, `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Base URL of the teammate's Python FastAPI AI service.
# Declared in docs/API_CONTRACT.md §2 and read by `src/lib/env.ts`; the HTTP client
# is `src/server/ai/client.ts`. Server-to-server only — never call it from the
# browser. Defaults to this value when unset, so the app still boots without it.
AI_SERVICE_URL="http://127.0.0.1:8000"
