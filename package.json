{
  "name": "upay-events",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "ai:install": "python -m pip install -r ai/requirements-train.txt",
    "ai:dev": "python -m uvicorn app.main:app --app-dir ai --host 127.0.0.1 --port 8000",
    "ai:data": "python ai/train/generate_data.py",
    "ai:train": "python ai/train/train_model.py",
    "ai:uplift": "python ai/train/train_uplift.py",
    "ai:loadtest": "python ai/tests/loadtest.py",
    "ai:test": "python -m pytest ai/tests -q"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "jsqr": "^1.4.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
